<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Sqrt_cal_1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Sqrt_cal_1"
    Title="Sqrt_cal_1">

    <TabBar>
        <ShellContent Title="{Binding [MainTitle], Source={x:Static local:LocalizationManager.Instance}}"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage" />

        <ShellContent Title="{Binding [ComplexTitle], Source={x:Static local:LocalizationManager.Instance}}"
                      ContentTemplate="{DataTemplate local:SecondPage}"
                      Route="SecondPage" />

        <ShellContent Title="{Binding [SettingsTitle], Source={x:Static local:LocalizationManager.Instance}}"
                      ContentTemplate="{DataTemplate local:SettingsPage}"
                      Route="SettingsPage" />
    </TabBar>
</Shell>