<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sqrt_cal_1"
             x:Class="Sqrt_cal_1.SettingsPage"
             Title="{Binding [SettingsTitle], Source={x:Static local:LocalizationManager.Instance}}"
             BackgroundColor="White">
    <!-- 1. Белый фон всей страницы -->

    <!-- 2. Grid делит экран: * (звездочка) = всё свободное место, Auto = размер по содержимому -->
    <Grid RowDefinitions="*, Auto">

        <!-- ВЕРХНЯЯ ЧАСТЬ: Настройки (центрированы по вертикали) -->
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="15" VerticalOptions="Center">

            <Label Text="{Binding [Precision], Source={x:Static local:LocalizationManager.Instance}}"
                   FontSize="18" FontAttributes="Bold" TextColor="Black" />

            <Label FontSize="16" TextColor="Black">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding [DecimalPlaces], Source={x:Static local:LocalizationManager.Instance}}" TextColor="Black" />
                        <!-- Выделим само число точности оранжевым цветом для красоты -->
                        <Span Text="{Binding Precision, StringFormat=' {0}'}" TextColor="#FF8C00" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Stepper Minimum="0" Maximum="15" Increment="1"
                Value="{Binding Precision}"
                HorizontalOptions="Start"
                WidthRequest="200"
                HeightRequest="40"
                BackgroundColor="#CCCCCC" />

            <!-- 3. Кнопка в оранжевом стиле -->
            <Button Text="{Binding [SwitchLanguage], Source={x:Static local:LocalizationManager.Instance}}"
                    Clicked="OnSwitchLanguageClicked"
                    BackgroundColor="#FF8C00" 
                    TextColor="White" 
                    CornerRadius="10"
                    Margin="0,20,0,0" />
        </VerticalStackLayout>

        <!-- НИЖНЯЯ ЧАСТЬ: Белка (автоматически прижимается к низу благодаря Grid.Row="1") -->
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,0,0,40">
                <!-- 5. Картинка белки. TintColor перекрашивает её в оранжевый (#FF8C00) -->
            <Image Source="belka3.png" WidthRequest="80" HeightRequest="80"  />

            <Label Text="Вы настраивайте, а она пока поест" TextColor="Black" FontSize="12" FontAttributes="Italic" HorizontalOptions="Center" Margin="0,10,0,0" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>